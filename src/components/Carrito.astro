---
/*
  Carrito de compras: panel lateral (<dialog>) que se abre al comprar un souvenir o con el botón
  “Carrito” del encabezado. Está en el Layout, así que existe en todas las páginas.
  Su lógica vive en src/scripts/carrito.ts; aquí solo está el HTML y los estilos.
  Es una compra simulada: “Ir a pagar” lleva a /pago, donde no se cobra nada.
*/
import Boton from "./ui/Boton.astro";
---

<dialog
  id="carrito"
  aria-labelledby="carrito-titulo"
  class="m-0 ml-auto h-dvh max-h-none w-full max-w-md border-l-2 border-borde bg-fondo p-0 text-texto shadow-marca backdrop:bg-texto/50"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-borde p-4 sm:p-6">
      <h2 id="carrito-titulo" class="text-2xl font-bold uppercase">Tu carrito</h2>
      <button
        type="button"
        data-cerrar-carrito
        class="rounded-marca bg-superficie px-4 py-2 font-titulos text-lg font-bold borde-marca"
      >
        Cerrar
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4 sm:p-6">
      <p data-carrito-vacio class="text-texto-suave">Tu carrito está vacío.</p>
      <ul data-carrito-lista></ul>
    </div>

    <div data-carrito-pie class="border-t border-borde p-4 sm:p-6" hidden>
      <p class="flex items-center justify-between text-xl font-bold">
        <span>Total</span>
        <span data-carrito-total>$0</span>
      </p>
      <div class="mt-4 flex flex-col gap-3">
        <Boton href="/pago" flecha>Ir a pagar</Boton>
        <Boton variante="secundario" data-cerrar-carrito="">Seguir comprando</Boton>
      </div>
    </div>
  </div>
</dialog>

<template id="carrito-item">
  <li data-id="" class="flex items-center justify-between gap-3 border-b border-borde py-4">
    <div class="min-w-0">
      <p data-nombre class="font-titulos text-lg font-bold uppercase"></p>
      <p data-precio class="text-texto-suave"></p>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-accion="menos"
        class="size-9 rounded-marca bg-superficie font-bold borde-marca"
      >
        −
      </button>
      <span data-cantidad class="min-w-6 text-center font-bold"></span>
      <button
        type="button"
        data-accion="mas"
        class="size-9 rounded-marca bg-superficie font-bold borde-marca"
      >
        +
      </button>
      <button type="button" data-accion="quitar" class="ml-2 underline underline-offset-4">
        Quitar
      </button>
    </div>
  </li>
</template>
